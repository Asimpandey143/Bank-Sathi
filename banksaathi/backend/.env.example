# BankSathi Backend Environment Configuration Template
# Copy this file to .env and configure your variables.
# NEVER commit real credentials or private keys to source control.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./banksaathi_demo.db
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Providers
VOICE_PROVIDER=mock
BANK_PROVIDER=mock
LLM_API_KEY=
VOICE_API_KEY=

# Risk Engine Configuration
RISK_THRESHOLD_MEDIUM=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=75
RISK_WEIGHT_AMOUNT_DEVIATION=30
RISK_WEIGHT_NEW_BENEFICIARY=25
RISK_WEIGHT_UNUSUAL_TIME=10
RISK_WEIGHT_UNTRUSTED_DEVICE=30
DAILY_TRANSACTION_LIMIT=50000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Agora Credentials (Media Plane)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Additional AI Provider Keys (Optional)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional Configurations
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_VOICE_ID=C3aqZfd4M0h7Ys5tWGIS
LOG_LEVEL=INFO
