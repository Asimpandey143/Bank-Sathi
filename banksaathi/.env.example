# BankSathi Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with secrets to source control.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./banksaathi_demo.db
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Providers
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
VOICE_PROVIDER=mock
BANK_PROVIDER=mock

# Additional AI Provider Keys (Optional)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Agora Credentials (Media Plane)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Optional Configurations
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_VOICE_ID=C3aqZfd4M0h7Ys5tWGIS
LOG_LEVEL=INFO

# Risk engine thresholds (configurable)
RISK_THRESHOLD_MEDIUM=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=75

# Risk feature weights
RISK_WEIGHT_AMOUNT_DEVIATION=30
RISK_WEIGHT_NEW_BENEFICIARY=25
RISK_WEIGHT_UNUSUAL_TIME=10
RISK_WEIGHT_UNTRUSTED_DEVICE=30

# Daily transaction limit (INR)
DAILY_TRANSACTION_LIMIT=50000

# CORS (JSON array format required by pydantic-settings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
