# BankSathi Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://banksaathi:banksaathi@postgres:5432/banksaathi

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Providers (set to "mock" for hackathon demo)
LLM_PROVIDER=mock
VOICE_PROVIDER=mock
BANK_PROVIDER=mock

# If LLM_PROVIDER=gemini, set this:
LLM_API_KEY=

# If VOICE_PROVIDER=google, set this:
VOICE_API_KEY=

# Risk engine thresholds (configurable)
RISK_THRESHOLD_MEDIUM=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=75

# Risk feature weights
RISK_WEIGHT_AMOUNT_DEVIATION=30
RISK_WEIGHT_NEW_BENEFICIARY=25
RISK_WEIGHT_UNUSUAL_TIME=10
RISK_WEIGHT_UNTRUSTED_DEVICE=30

# Daily transaction limit (INR)
DAILY_TRANSACTION_LIMIT=50000

# CORS (JSON array format required by pydantic-settings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
